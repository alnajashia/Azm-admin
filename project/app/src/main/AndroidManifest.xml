<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Wireless-debugging start: the manager talks to the device's own
         ADB daemon over the local network interface (127.0.0.1) once the
         user pairs it from Developer options. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Lets the manager see (and only see) the known client app for status
         and approval shortcuts; package identity of other clients is
         resolved by the privileged server, not by the manager UI. -->
    <queries>
        <package android:name="io.github.alnajashia.dominanter" />
    </queries>

    <application
        android:name=".AzmAdminApplication"
        android:label="@string/app_name"
        android:theme="@style/Theme.AzmAdmin"
        android:supportsRtl="true">

        <activity
            android:name=".manager.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pairing guide (Shizuku-shaped flow): starts PairingService
             and walks the user through Developer options. -->
        <activity
            android:name=".manager.PairingTutorialActivity"
            android:exported="false" />

        <!-- Terminal-style log screen for the wireless start. -->
        <activity
            android:name=".manager.StarterActivity"
            android:exported="false"
            android:label="@string/starter_title" />

        <!-- Foreground service behind the pairing notification: it
             listens for the mDNS pairing announcement and pairs with
             the code the user types into the notification. -->
        <service
            android:name=".manager.PairingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="adb_pairing" />
        </service>

        <!-- Opened by the privileged server (via `am start`) when a client
             requests authorization. The approval itself is recorded by the
             server through its manager-only approveClient call, which this
             activity makes as the manager app. -->
        <activity
            android:name=".manager.RequestPermissionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.AzmAdmin.Dialog" />

        <!-- Receives the server binder push and redistributes it to client
             apps that pull it through the client library. Exported by
             necessity (the server process and other apps call it); holding
             the binder is not a privilege, the server authorizes per call. -->
        <provider
            android:name=".manager.ManagerBinderProvider"
            android:authorities="io.github.alnajashia.azmadmin.binder"
            android:exported="true" />
    </application>
</manifest>
